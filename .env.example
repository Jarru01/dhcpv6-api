# Copy to /etc/dhcpv6-api.env (systemd) or .env (local) and set a real key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DHCPV6_API_KEY=change-me-to-a-long-random-string

# Defaults shown; only set these if your paths differ
# DHCPV6_KEA_CONFIG_PATH=/etc/kea/kea-dhcp6.conf
# DHCPV6_KEA_CONTROL_SOCKET=/run/kea/kea6-ctrl-socket
# DHCPV6_KEA_LEASES_FILE=/var/lib/kea/kea-leases6.csv
