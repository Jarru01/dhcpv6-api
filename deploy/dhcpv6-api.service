# /etc/systemd/system/dhcpv6-api.service
#
# Note: systemd only treats lines that START with '#' as comments, so every
# comment in this file sits on its own line. A trailing "Key=value  # note"
# silently becomes part of the value.
#
# Install:
#   sudo cp deploy/dhcpv6-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dhcpv6-api
# Logs:
#   journalctl -u dhcpv6-api -f

[Unit]
Description=DHCPv6 REST API (FastAPI/Uvicorn) for Kea
After=network-online.target kea-dhcp6-server.service
# Wants= rather than Requires=: with Requires=, a Kea restart would also stop
# this service, killing the API in the middle of the request that caused it.
Wants=network-online.target kea-dhcp6-server.service

[Service]
Type=simple
User=avs
Group=avs
# _kea group gives access to /etc/kea and the Kea control socket
SupplementaryGroups=_kea
WorkingDirectory=/opt/dhcpv6-api
# Must define DHCPV6_API_KEY (see .env.example); chmod 600, owned by root
EnvironmentFile=/etc/dhcpv6-api.env
# The firewall only allows port 8000 from the private interface (ens4).
ExecStart=/opt/dhcpv6-api/venv/bin/uvicorn --factory dhcpv6_api.main:create_app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

# Hardening: the service only needs to write the Kea config directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/kea

[Install]
WantedBy=multi-user.target
